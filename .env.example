# UVIP-AI environment configuration (contoh)
# Salin ke .env lalu sesuaikan:  cp .env.example .env

# --- Backend UVIP (untuk seed data & integrasi) ---
UVIP_API_BASE_URL=http://127.0.0.1:8000
UVIP_API_TOKEN=

# --- Device ---
# auto = pakai GPU bila ada, jika tidak fallback ke CPU
UVIP_DEVICE=auto
# fp16 hemat VRAM (disarankan untuk GPU 6-8GB seperti RTX 3060 Laptop)
UVIP_USE_FP16=true
# Karena VRAM 6GB: muat model satu per satu (load->infer->unload) bila true
UVIP_LOW_VRAM_MODE=true

# --- Model HuggingFace ---
HF_HOME=./models/hf_cache
SEGFORMER_MODEL=nvidia/segformer-b5-finetuned-cityscapes-1024-1024
DINOV2_MODEL=facebook/dinov2-large
YOLO_MODEL=yolov8n.pt

# --- Paths ---
DATA_RAW_DIR=./data/raw
DATA_EXTRACTED_DIR=./data/extracted
MASKS_DIR=./data/masks
DATASETS_DIR=./data/datasets
MODELS_DIR=./models

# --- Target performa (Step 9) ---
LATENCY_TARGET_MS=700
