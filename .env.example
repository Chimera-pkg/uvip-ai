# UVIP-AI environment configuration (contoh)
# Salin ke .env lalu sesuaikan:  cp .env.example .env

# --- Backend UVIP (untuk seed data & integrasi) ---
UVIP_API_BASE_URL=http://127.0.0.1:8000
UVIP_API_TOKEN=

# --- Device ---
# auto = pakai GPU bila ada, jika tidak fallback ke CPU
UVIP_DEVICE=auto
# fp16 hemat VRAM (disarankan untuk GPU 6-8GB seperti RTX 3060 Laptop)
UVIP_USE_FP16=true
# Karena VRAM 6GB: muat model satu per satu (load->infer->unload) bila true
UVIP_LOW_VRAM_MODE=true

# --- Model HuggingFace ---
HF_HOME=./models/hf_cache
SEGFORMER_MODEL=nvidia/segformer-b5-finetuned-cityscapes-1024-1024
# DINOv2: small (CPU, ~500MB) | base (~1.5GB) | large (GPU, ~4GB)
DINOV2_MODEL=facebook/dinov2-small
YOLO_MODEL=yolov8n.pt

# --- Paths ---
DATA_RAW_DIR=./data/raw
DATA_EXTRACTED_DIR=./data/extracted
MASKS_DIR=./data/masks
DATASETS_DIR=./data/datasets
MODELS_DIR=./models

# --- Target performa (Step 9) ---
LATENCY_TARGET_MS=700

# --- LLM gateway (9router) — router /llm/* ---
# Upstream OpenAI-compatible (hanya POST); /llm/* menambah varian GET.
NINE_ROUTER_URL=https://9router-production-fc96.up.railway.app/v1
NINE_ROUTER_KEY=
NINE_ROUTER_MODEL=lo/deepseek-v4.1-flash
# Model untuk POST /llm/vision — wajib vision-capable (lihat GET /llm/models -> capabilities.vision).
# Terverifikasi hidup & akurat: lo/glm-5.3-flash. HINDARI x/glm-5.3-flash (mengaku buta)
# dan x/deepseek-v4.1-flash (balas kosong).
NINE_ROUTER_VISION_MODEL=lo/glm-5.3-flash
# Model untuk POST /llm/advise — analisa foto ruang publik -> rekomendasi + prompt gambar.
NINE_ROUTER_ADVISE_MODEL=lo/glm-5.3-flash
# Rantai fallback (dipisah koma). Ujungnya grok: paling tajam walau lambat (~44s).
NINE_ROUTER_FALLBACKS=x/gpt-6-luna,lo/deepseek-v4.1-flash,gcli/grok-4.6
NINE_ROUTER_TIMEOUT_S=120

# --- OpenAI Images API — endpoint POST /llm/generate ---
# Key project OpenAI (sk-proj-...). Isi hanya di .env (gitignored), jangan di-commit.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# 1024x1024 | 1536x1024 | 1024x1536
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_TIMEOUT_S=120
